{
  "schemaVersion": 1,
  "provider": "cursor",
  "mode": "real-provider",
  "command": "/Users/nickw/.local/bin/agent",
  "args": [
    "acp"
  ],
  "runtime": {
    "node": "v26.0.0",
    "platform": "darwin",
    "arch": "arm64",
    "providerBinaryPresent": true,
    "isolatedHome": true,
    "processExit": {
      "code": 143,
      "signal": null
    }
  },
  "providerMcpServers": [
    {
      "type": "http",
      "name": "homeassistant-assist",
      "url": "http://127.0.0.1:56690/homeassistant-assist",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer [REDACTED]"
        }
      ]
    },
    {
      "type": "http",
      "name": "homeassistant-advanced",
      "url": "http://127.0.0.1:56690/homeassistant-advanced",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer [REDACTED]"
        }
      ]
    }
  ],
  "tests": {
    "initialize": {
      "status": "passed",
      "protocolVersion": 1,
      "agentCapabilities": {
        "loadSession": true,
        "mcpCapabilities": {
          "http": true,
          "sse": true
        },
        "promptCapabilities": {
          "audio": false,
          "embeddedContext": false,
          "image": true
        },
        "sessionCapabilities": {
          "list": {}
        }
      }
    },
    "authStatus": {
      "status": "observed",
      "authMethods": [
        {
          "id": "cursor_login",
          "name": "Cursor Login",
          "description": "Authenticate using existing Cursor login credentials. Run 'agent login' first if not logged in."
        }
      ]
    },
    "sessionNew": {
      "status": "blocked-or-failed",
      "error": "RequestError: Authentication required"
    },
    "mcpInjection": {
      "status": "inconclusive",
      "reason": "session/new failed before provider MCP acceptance could be distinguished",
      "error": "RequestError: Authentication required"
    }
  }
}
